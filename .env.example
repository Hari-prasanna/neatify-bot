# ============================================================
# .env.example — copy this to .env and fill in your values
# ============================================================
# This file is safe to commit (no real secrets here).
# Your actual .env is in .gitignore.
#
# DEV  → run dev/main.py locally with these variables
# PROD → set equivalent values in GitHub Actions secrets
#        (Settings → Secrets → Actions) for the Lambda deploy
# ============================================================

# --- Environment tag ---
# Written to every sys_logs row so you can filter dev vs prod events.
# Set to "dev" here. Lambda automatically gets BOT_ENV=prod via template.yml.
BOT_ENV=dev

# --- Telegram ---
# Get from @BotFather → /newbot → copy the token
TELEGRAM_TOKEN=123456789:ABCDefGhIJKlmNOPqRsTUVwXYz

# Your personal Telegram user ID — grants access to /activate and /deletelast.
# To find it: message @userinfobot directly (not in the group), it replies with your ID.
# Stored as an env var (not in the DB) so admin access can never be toggled by a query.
ADMIN_TELEGRAM_ID=987654321

# The numeric ID of your Telegram group chat.
# To find it: add @userinfobot to the group and it will report the chat ID.
TELEGRAM_GROUP_ID=-1001234567890

# Production-only: a random secret string you choose (e.g. openssl rand -hex 32).
# Set during webhook registration so Lambda can verify requests come from Telegram.
# Not needed for local dev (polling mode skips this check).
TELEGRAM_SECRET_TOKEN=replace_with_a_long_random_string

# --- Supabase ---
# Project URL: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Anon/service-role key: Supabase Dashboard → Project Settings → API → anon public
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
